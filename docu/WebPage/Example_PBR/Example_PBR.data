{
    SV_Target = texture(s_skyBoxsmpl, normalize(vec4(v_VIEWRAY.xy, gl_FrontFacing ? (-1.0) : 1.0, 0.0) * spvWorkaroundRowMajor(cMatrix)).xyz);
